# URL de la API de Brain Intelligence
VITE_API_URL=https://api.brainstudioagencia.com

# Backend / base de datos
DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=change-me

# Recuperacion de contrasena por correo Google/Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-google-workspace-email@domain.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Brainstudio Intelligence <your-google-workspace-email@domain.com>"
