# URL de la API de Brain Intelligence
VITE_API_URL=https://api.brainstudioagencia.com

# Backend / base de datos
DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=change-me
# Cifra tokens de integraciones y el secreto de la verificación en dos pasos (32 caracteres o 64 hex).
ENCRYPTION_KEY=change-me-32-characters-exactly!
# Roles con verificación en dos pasos obligatoria, separados por comas (p. ej. ADMIN,PROJECT_MANAGER).
# `*` = todo el equipo. Vacío = nadie obligado.
MFA_REQUIRED_ROLES=

# Publicación automática en Instagram y Facebook: token del usuario del sistema del Business Manager
# de Brain Studio (Meta), sin vencimiento. Sin él, no se pueden conectar cuentas ni publicar.
META_SYSTEM_USER_TOKEN=

# Notificaciones nativas Web Push (genera el par una sola vez con web-push)
WEB_PUSH_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_SUBJECT=mailto:soporte@brainstudioagencia.com

# Recuperacion de contrasena por correo Google/Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-google-workspace-email@domain.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Brainstudio Intelligence <your-google-workspace-email@domain.com>"

# Archivos generales de plataforma: entregables y cargas manuales de Drive.
# Destino propio, separado de chat y agency-memory, sin fallback al faltar configuración.
# LEGACY conserva su origen: AWS_* en finales anteriores; BRIA_STORAGE_* en Drive anterior.
PLATFORM_STORAGE_ENDPOINT=https://t3.storageapi.dev
PLATFORM_STORAGE_BUCKET=
PLATFORM_STORAGE_ACCESS_KEY_ID=
PLATFORM_STORAGE_SECRET_ACCESS_KEY=
# Railway nuevo usa virtual-hosted; activar solo para un endpoint que exija path-style.
PLATFORM_STORAGE_FORCE_PATH_STYLE=false
