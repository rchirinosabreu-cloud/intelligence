generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cliente de la Agencia
model Client {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // Para urls tipo /sunpartners
  status    String   @default("active") // active, paused, archived
  logoUrl   String?
  createdAt DateTime @default(now())

  // Relaciones
  brandAssets BrandAsset[]
  files       ClientFile[]
  links       ClientLink[]
  tasks       ClientTask[]
  announcements ClientAnnouncement[]
  campfireMessages CampfireMessage[]
  nativeTasks Task[]
}

// Miembros del Equipo de la Agencia
model TeamMember {
  id        String   @id @default(uuid())
  name      String
  role      String   // "Director", "Project Manager", "Diseñador", "Copywriter", "Editor de Video", "Ejecutivo de Cuentas", "Otro"
  email     String?
  avatarUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  nativeTasks     Task[]
  clientTasks     ClientTask[]
  campfireMessages CampfireMessage[]
}

// Fase 1: Migración del Kanban de Google Sheets a Prisma
model Task {
  id        String   @id @default(uuid())
  title     String
  dueDate   DateTime?
  assigneeId String?
  assignee  TeamMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  comments  String?
  status    String   @default("Pendiente") // Pendiente, En proceso, Realizado
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Activos de Marca (Colores, Fuentes)
model BrandAsset {
  id        String  @id @default(uuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  type      String  // 'COLOR', 'TYPOGRAPHY', 'LINK'
  name      String  // 'Color Primario', 'Fuente Web'
  value     String  // '#FF0000', 'Montserrat'
}

// Archivos del Cliente (Bucket References)
model ClientFile {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  name        String   // Nombre visible
  bucketUrl   String   // URL del archivo en Railway/S3
  category    String   // 'Legal', 'Deliverable', 'Asset'
  createdAt   DateTime @default(now())
}

// Enlaces Clave del Cliente (Max 5 por cliente)
model ClientLink {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  title     String
  url       String
  createdAt DateTime @default(now())
}

// Tareas del Cliente (Feature nueva)
model ClientTask {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  text      String
  completed Boolean  @default(false)
  dueDate   DateTime?
  assigneeId String?
  assignee  TeamMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// Anuncios específicos por Cliente
model ClientAnnouncement {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  content   String   // Sin límite de caracteres
  type      String   // 'urgent', 'win', 'info'
  createdAt DateTime @default(now())
}

// Chat Campfire (Inmutable)
model CampfireMessage {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  content   String
  authorId  String
  author    TeamMember @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

// Anuncios Globales del Dashboard (Feature nueva)
model GlobalAnnouncement {
  id        String   @id @default(uuid())
  content   String   // Max 140
  type      String   // 'urgent', 'win', 'info'
  createdAt DateTime @default(now())
}
