generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  password            String
  role                String               @default("EDITOR")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  avatarUrl           String?
  isActive            Boolean              @default(true)
  bio                 String?
  authoredFeedback    FeedbackRecord[]     @relation("AuthoredFeedback")
  receivedFeedback    FeedbackRecord[]     @relation("ReceivedFeedback")
  generalChatMessages GeneralChatMessage[]
  notifications       Notification[]
  createdTasks        Task[]               @relation("CreatedTasks")
  notes               UserNote[]
}

model UserNote {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  relatedId  String?
  type       String?
  resourceId String?
  url        String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GeneralChatMessage {
  id        String   @id @default(uuid())
  content   String
  authorId  String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
}

model Client {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  status              String               @default("active")
  logoUrl             String?
  createdAt           DateTime             @default(now())
  aiInstructions      String?
  adAccountId         String?
  facebookPageId      String?
  instagramBusinessId String?
  brandAssets         BrandAsset[]
  announcements       ClientAnnouncement[]
  clientFiles         ClientFile[]
  links               ClientLink[]
  tasks               ClientTask[]
  contentPlans        ContentPlan[]
  flowMessages        FlowMessage[]
  integrations        Integration[]
  nativeTasks         Task[]
}

model ContentPlan {
  id            String            @id @default(uuid())
  clientId      String
  month         Int
  year          Int
  status        ContentPlanStatus @default(PLANIFICACION)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  ownerId       String?
  internalNotes String?
  shareToken    String?           @unique
  contentItems  ContentItem[]
  client        Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner         TeamMember?       @relation(fields: [ownerId], references: [id])
}

model ContentItem {
  id          String            @id @default(uuid())
  planId      String
  objective   String
  format      String
  copyText    String
  captionText String
  publishDate DateTime
  mediaUrl    String[]          @default([])
  status      ContentItemStatus @default(BORRADOR)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  assetsLinks   String[]          @default([])
  internalNotes String?
  comments      String?
  deletedAt     DateTime?
  plan        ContentPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Integration {
  id             String   @id @default(uuid())
  clientId       String
  provider       String
  encryptedToken String
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, provider])
}

model TeamMember {
  id           String        @id @default(uuid())
  name         String
  role         String
  email        String?
  avatarUrl    String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String?       @unique
  desktopX     Int?
  desktopY     Int?
  statusMessage String?
  clientTasks  ClientTask[]
  contentPlans ContentPlan[]
  flowMessages FlowMessage[]
  nativeTasks  Task[]
}

model OperationalEvent {
  id          String   @id @default(uuid())
  title       String
  type        String   // PRODUCTION, ABSENCE, PROJECT, MEETING
  description String?
  startAt     DateTime
  endAt     DateTime
  memberIds   String[] @default([]) // IDs of TeamMembers involved
  recurrence  String?  // NONE, WEEKLY
  recurrenceEnd DateTime?
  meetingLink String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeletedTaskLog {
  id             String   @id @default(uuid())
  originalTaskId String
  taskTitle      String
  clientId       String?
  deletedById    String?
  reason         String
  deletedAt      DateTime @default(now())
}

model Task {
  id            String       @id @default(uuid())
  title         String
  dueDate       DateTime?
  assigneeId    String?
  comments      String?
  clientId      String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  completedAt   DateTime?
  creatorId     String?
  status        TaskStatus   @default(PENDIENTE)
  isPriority    Boolean      @default(false)
  isSpecial     Boolean      @default(false)
  referenceUrl  String?
  specialType   String?
  contentItemId String?
  aiCategory    String?
  aiComplexity  String?
  returnCount   Int          @default(0)
  isReturned    Boolean      @default(false)
  returnedAt    DateTime?
  startedAt     DateTime?
  assignee      TeamMember?  @relation(fields: [assigneeId], references: [id])
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id])
  creator       User?        @relation("CreatedTasks", fields: [creatorId], references: [id])
}

model BrandAsset {
  id       String @id @default(uuid())
  clientId String
  type     String
  name     String
  value    String
  client   Client @relation(fields: [clientId], references: [id])
}

model ClientFile {
  id        String    @id @default(uuid())
  clientId  String
  name      String
  bucketUrl String
  category  String    @default("Entregable")
  createdAt DateTime  @default(now())
  mimeType  String?
  size      Int?
  deletedAt DateTime?
  updatedAt DateTime  @default(now()) @updatedAt
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientLink {
  id        String   @id @default(uuid())
  clientId  String
  title     String
  url       String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id])
}

model ClientTask {
  id         String      @id @default(uuid())
  clientId   String
  text       String
  completed  Boolean     @default(false)
  dueDate    DateTime?
  assigneeId String?
  createdAt  DateTime    @default(now())
  assignee   TeamMember? @relation(fields: [assigneeId], references: [id])
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientAnnouncement {
  id        String   @id @default(uuid())
  clientId  String
  content   String
  type      String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model FeedbackRecord {
  id               String       @id @default(uuid())
  collaboratorId   String
  authorId         String
  type             FeedbackType @default(ESCRITO)
  date             DateTime     @default(now())
  strengths        String
  improvementAreas String
  actionItems      String
  privateNote      String?
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  author           User         @relation("AuthoredFeedback", fields: [authorId], references: [id], onDelete: Cascade)
  collaborator     User         @relation("ReceivedFeedback", fields: [collaboratorId], references: [id], onDelete: Cascade)
}

model FlowMessage {
  id        String     @id @default(uuid())
  clientId  String
  content   String
  authorId  String
  createdAt DateTime   @default(now())
  author    TeamMember @relation(fields: [authorId], references: [id])
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model GlobalAnnouncement {
  id        String   @id @default(uuid())
  content   String
  type      String
  createdAt DateTime @default(now())
}

enum TaskStatus {
  PENDIENTE
  EN_CURSO
  REALIZADA
  DEVUELTA
}

enum ContentPlanStatus {
  PLANIFICACION
  EN_APROBACION
  ACTIVO
  FINALIZADO
}

enum ContentItemStatus {
  BORRADOR
  EN_REVISION
  APROBADO
  PUBLICADO
  REALIZADO
  EN_PRODUCCION
  DEVUELTO
}

enum FeedbackType {
  ESCRITO
  UNO_A_UNO
}
