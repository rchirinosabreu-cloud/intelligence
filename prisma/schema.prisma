generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  ADMIN
  PROJECT_MANAGER
  EDITOR
  VIEWER
}

enum FinancialAccessRole {
  NONE
  VIEWER
  EDITOR
  APPROVER
  ADMIN
}

enum TaskPriority {
  URGENTE
  ALTA
  NORMAL
}

model User {
  id                          String                  @id @default(uuid())
  name                        String
  email                       String                  @unique
  password                    String
  role                        SystemRole              @default(VIEWER)
  modulePermissions           Json?                   @default("{\"dashboard\": true, \"manager\": false, \"gestion\": false, \"actividad\": false, \"reportes\": false, \"inspiracion\": false, \"parrillas\": false, \"minutas\": false, \"cotizaciones\": false, \"financiero\": false, \"radar\": false, \"clientes\": false, \"equipo\": false}")
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  avatarUrl                   String?
  isActive                    Boolean                 @default(true)
  bio                         String?
  hasFinancialAccess          Boolean                 @default(false)
  financialRole               FinancialAccessRole     @default(NONE)
  mustChangePassword          Boolean                 @default(false)
  passwordChangedAt           DateTime?
  sessionVersion              Int                     @default(0)
  authoredFeedback            FeedbackRecord[]        @relation("AuthoredFeedback")
  receivedFeedback            FeedbackRecord[]        @relation("ReceivedFeedback")
  generalChatMessages         GeneralChatMessage[]
  authoredGlobalAnnouncements GlobalAnnouncement[]
  createdOperationalEvents    OperationalEvent[]      @relation("OperationalEventCreator")
  notifications               Notification[]
  pushSubscriptions           PushSubscription[]
  operationalTraceActions     OperationalTraceEvent[] @relation("OperationalTraceActor")
  operationalTraceSubjects    OperationalTraceEvent[] @relation("OperationalTraceSubject")
  createdTasks                Task[]                  @relation("CreatedTasks")
  notes                       UserNote[]
  taskComments                TaskComment[]
  taskCommentReactions        TaskCommentReaction[]
  taskFollowing               TaskFollower[]
  payrollContracts            PayrollContract[]
  payrollTransactions         PayrollTransaction[]
  financialRecords            FinancialRecord[]
  createdFinancialRecords     FinancialRecord[]       @relation("FinancialRecordCreator")
  closedFinancialPeriods      FinancialPeriod[]       @relation("FinancialPeriodClosedBy")
  financialAuditEvents        FinancialAuditEvent[]   @relation("FinancialAuditActor")
  createdReceivablePayments   ReceivablePayment[]     @relation("ReceivablePaymentCreator")
  financialImportBatches      FinancialImportBatch[]  @relation("FinancialImportUser")
  financialCollaborators      FinancialCollaborator[]
  passwordResetCodes          PasswordResetCode[]
  teamMember                  TeamMember?
}

model PasswordResetCode {
  id        String    @id @default(uuid())
  userId    String
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
}

model UserNote {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  message    String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  relatedId  String?
  type       String?
  resourceId String?
  url        String?
  taskId     String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model PushSubscription {
  id           String    @id @default(uuid())
  userId       String
  endpoint     String    @unique
  p256dh       String
  auth         String
  userAgent    String?
  deviceLabel  String?
  preferences  Json?     @default("{\"tasks\": true, \"mentions\": true, \"announcements\": true}")
  isActive     Boolean   @default(true)
  failureCount Int       @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model OperationalTraceEvent {
  id            String   @id @default(uuid())
  eventType     String
  actorId       String?
  subjectUserId String?
  taskId        String?
  metadata      Json?
  occurredAt    DateTime @default(now())
  actor         User?    @relation("OperationalTraceActor", fields: [actorId], references: [id], onDelete: SetNull)
  subjectUser   User?    @relation("OperationalTraceSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([actorId, eventType, occurredAt])
  @@index([subjectUserId, occurredAt])
  @@index([taskId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([occurredAt])
}

model GeneralChatMessage {
  id        String   @id @default(uuid())
  content   String
  authorId  String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
}

enum ClientStatus {
  PROPUESTA_ENVIADA
  CONTRATO_PENDIENTE
  RECOPILANDO_ACCESOS
  ACTIVO
  ALERTA_RENOVACION
  CERRADO
}

model Client {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  status              ClientStatus         @default(ACTIVO)
  monthlyFee          Decimal?
  isArchived          Boolean              @default(false)
  logoUrl             String?
  createdAt           DateTime             @default(now())
  aiInstructions      String?
  adAccountId         String?
  facebookPageId      String?
  instagramBusinessId String?
  brandAssets         BrandAsset[]
  integrationsV2      AgencyIntegration[]
  announcements       ClientAnnouncement[]
  clientFiles         ClientFile[]
  links               ClientLink[]
  tasks               ClientTask[]
  contentPlans        ContentPlan[]
  flowMessages        FlowMessage[]
  integrations        Integration[]
  nativeTasks         Task[]
  agencyContexts      AgencyContext[]
  boards              Board[]
  healthRecords       ClientHealth[]
  responsibleId       String?
  responsible         TeamMember?          @relation("ClientResponsible", fields: [responsibleId], references: [id])
  financialRecords    FinancialRecord[]
  accountsReceivables AccountsReceivable[]
  metricReports       MetricReport[]

  @@index([isArchived, responsibleId])
}

model ClientHealth {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month         Int // 1 - 12
  year          Int // Ej: 2026
  score         Int // Puntaje final calculado (0 - 100)
  contentStatus String // APROBADA, EN_PROCESO, SIN_PARRILLA (Manual o Auto)
  reportStatus  String // COMPLETA, EN_PROCESO, CRITICO
  isExternal    Boolean  @default(false) // Flag si se gestiona fuera de la app (Excel)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([clientId, month, year])
}

model Board {
  id        String      @id @default(uuid())
  clientId  String?
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  client    Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items     BoardItem[]

  @@index([clientId, updatedAt])
}

model BoardItem {
  id         String        @id @default(uuid())
  boardId    String
  type       BoardItemType
  contentUrl String?
  assetUrl   String?
  metadata   Json?
  positionX  Int           @default(0)
  positionY  Int           @default(0)
  comment    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  board      Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt])
}

enum BoardItemType {
  image
  link
  text
}

model ContentPlan {
  id                  String            @id @default(uuid())
  clientId            String
  month               Int
  year                Int
  status              ContentPlanStatus @default(PLANIFICACION)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?
  ownerId             String?
  internalNotes       String?
  strategicObjectives String?
  shareToken          String?           @unique
  contentItems        ContentItem[]
  client              Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner               TeamMember?       @relation(fields: [ownerId], references: [id])

  @@index([clientId, deletedAt, year, month])
  @@index([ownerId, deletedAt])
}

model ContentItem {
  id                 String            @id @default(uuid())
  planId             String
  objective          String
  format             String
  copyText           String
  captionText        String
  publishDate        DateTime
  mediaUrl           String[]          @default([])
  status             ContentItemStatus @default(BORRADOR)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  assetsLinks        String[]          @default([])
  internalNotes      String?
  comments           String?
  finalAssetKey      String?
  finalAssetName     String?
  finalAssetMimeType String?
  finalAssetSize     Int?
  deletedAt          DateTime?
  plan               ContentPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  tasks              Task[]

  @@index([planId, deletedAt, publishDate])
  @@index([status, publishDate])
}

model Integration {
  id             String   @id @default(uuid())
  clientId       String
  provider       String
  encryptedToken String
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, provider])
}

model TeamMember {
  id                 String        @id @default(uuid())
  name               String
  role               String
  email              String?
  avatarUrl          String?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  userId             String?       @unique
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  desktopX           Int?
  desktopY           Int?
  statusMessage      String?
  clientTasks        ClientTask[]
  contentPlans       ContentPlan[]
  flowMessages       FlowMessage[]
  nativeTasks        Task[]
  responsibleClients Client[]      @relation("ClientResponsible")
}

model OperationalEvent {
  id                   String    @id @default(uuid())
  title                String
  type                 String // PRODUCTION, ABSENCE, PROJECT, MEETING
  description          String?
  startAt              DateTime
  endAt                DateTime
  isAllDay             Boolean   @default(false)
  memberIds            String[]  @default([]) // IDs of TeamMembers involved
  recurrence           String? // NONE, WEEKLY
  recurrenceEnd        DateTime?
  meetingLink          String?
  source               String    @default("BRAIN")
  organizerEmail       String?
  attendeeEmails       String[]  @default([])
  attendeeResponses    Json?
  googleConnectionId   String?
  googleConnection     GoogleCalendarConnection? @relation(fields: [googleConnectionId], references: [id], onDelete: SetNull)
  googleCalendarId     String?
  googleEventId        String?
  googleICalUID        String?
  googleEtag           String?
  googleHtmlLink       String?
  googleMeetSpaceName  String?
  googleMeetAccessType String?
  googleSyncStatus     String?
  googleLastSyncedAt   DateTime?
  googleUpdatedAt      DateTime?
  createdById          String?
  createdBy            User?     @relation("OperationalEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  googleLinks          GoogleCalendarEventLink[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([startAt])
  @@index([googleCalendarId, googleEventId])
  @@index([googleConnectionId, googleCalendarId, googleEventId])
  @@index([createdById, createdAt])
}

model GoogleCalendarConnection {
  id              String                      @id @default(uuid())
  email           String                      @unique
  calendarId      String                      @default("primary")
  encryptedTokens String
  scopes          String[]                    @default([])
  isActive        Boolean                     @default(true)
  connectedById   String?
  connectedAt     DateTime                    @default(now())
  lastSyncedAt    DateTime?
  syncToken       String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  channels        GoogleCalendarSyncChannel[]
  events          OperationalEvent[]
  eventLinks      GoogleCalendarEventLink[]

  @@index([isActive])
}

model GoogleCalendarEventLink {
  id                 String                   @id @default(uuid())
  operationalEventId String
  connectionId       String
  calendarId         String
  googleEventId      String
  googleICalUID      String?
  googleEtag         String?
  isOrganizer        Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  operationalEvent   OperationalEvent         @relation(fields: [operationalEventId], references: [id], onDelete: Cascade)
  connection         GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, calendarId, googleEventId])
  @@index([operationalEventId])
  @@index([googleICalUID])
}

model GoogleCalendarSyncChannel {
  id           String                   @id @default(uuid())
  connectionId String
  channelId    String                   @unique
  resourceId   String
  resourceUri  String?
  token        String?
  expiresAt    DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  connection   GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([expiresAt])
}

model DeletedTaskLog {
  id             String   @id @default(uuid())
  originalTaskId String
  taskTitle      String
  clientId       String?
  deletedById    String?
  reason         String
  deletedAt      DateTime @default(now())
}

model Task {
  id              String           @id @default(uuid())
  title           String
  dueDate         DateTime?
  assigneeId      String?
  comments        String?
  clientId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  completedAt     DateTime?
  creatorId       String?
  status          TaskStatus       @default(PENDIENTE)
  isPriority      Boolean          @default(false)
  priority        TaskPriority?
  isSpecial       Boolean          @default(false)
  referenceUrl    String?
  specialType     String?
  contentItemId   String?
  aiCategory      String?
  aiComplexity    String?
  returnCount     Int              @default(0)
  isReturned      Boolean          @default(false)
  returnedAt      DateTime?
  startedAt       DateTime?
  sortOrder       Int?             @default(0)
  assignee        TeamMember?      @relation(fields: [assigneeId], references: [id])
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contentItem     ContentItem?     @relation(fields: [contentItemId], references: [id])
  creator         User?            @relation("CreatedTasks", fields: [creatorId], references: [id])
  taskComments    TaskComment[]
  followers       TaskFollower[]
  taskAttachments TaskAttachment[]

  @@index([assigneeId, status, dueDate])
  @@index([creatorId, status, createdAt])
  @@index([clientId, status, createdAt])
  @@index([status, completedAt])
  @@index([contentItemId, title])
}

enum AttachmentCategory {
  REFERENCIA
  INSUMO
}

model TaskAttachment {
  id        String             @id @default(uuid())
  taskId    String
  url       String
  name      String?
  category  AttachmentCategory @default(REFERENCIA)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  commentId String?

  task    Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment TaskComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([commentId])
}

model TaskFollower {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String?
  content   String
  type      String   @default("human") // human, system_return, system_reintegrate
  createdAt DateTime @default(now())
  isEdited  Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt

  task        Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User?                 @relation(fields: [authorId], references: [id], onDelete: SetNull)
  attachments TaskAttachment[]
  reactions   TaskCommentReaction[]

  @@index([taskId])
  @@index([taskId, createdAt])
}

model TaskCommentReaction {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
}

model BrandAsset {
  id       String @id @default(uuid())
  clientId String
  type     String
  name     String
  value    String
  client   Client @relation(fields: [clientId], references: [id])
}

model ClientFile {
  id        String    @id @default(uuid())
  clientId  String
  name      String
  bucketUrl String
  category  String    @default("Entregable")
  createdAt DateTime  @default(now())
  mimeType  String?
  size      Int?
  deletedAt DateTime?
  updatedAt DateTime  @default(now()) @updatedAt
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, deletedAt, createdAt])
}

model ClientLink {
  id        String   @id @default(uuid())
  clientId  String
  title     String
  url       String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id])
}

model ClientTask {
  id         String      @id @default(uuid())
  clientId   String
  text       String
  completed  Boolean     @default(false)
  dueDate    DateTime?
  assigneeId String?
  createdAt  DateTime    @default(now())
  assignee   TeamMember? @relation(fields: [assigneeId], references: [id])
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientAnnouncement {
  id        String   @id @default(uuid())
  clientId  String
  content   String
  type      String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model FeedbackRecord {
  id               String       @id @default(uuid())
  collaboratorId   String
  authorId         String
  type             FeedbackType @default(ESCRITO)
  date             DateTime     @default(now())
  strengths        String
  improvementAreas String
  actionItems      String
  privateNote      String?
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  author           User         @relation("AuthoredFeedback", fields: [authorId], references: [id], onDelete: Cascade)
  collaborator     User         @relation("ReceivedFeedback", fields: [collaboratorId], references: [id], onDelete: Cascade)
}

model AgencyContext {
  id               String                       @id @default(uuid())
  content          String
  vectorEmbeddings Unsupported("vector(3072)")?
  type             String                       @default("TEXT") // TEXT or IMAGE
  status           String                       @default("APPROVED") // PENDING, APPROVED, DISCARDED
  clientId         String?
  metadata         Json?
  maxStreak        Int?                         @default(0)
  createdAt        DateTime                     @default(now())
  client           Client?                      @relation(fields: [clientId], references: [id])
}

model SystemStreak {
  id                String    @id @default("global")
  currentStreak     Int       @default(0)
  highestStreak     Int       @default(0)
  lastResetAt       DateTime?
  lastIncrementedAt DateTime?
  updatedAt         DateTime  @updatedAt
}

model AutomationConfig {
  id             String    @id @default("global")
  storageState   Json?
  monitoredChats Json?
  lastRun        DateTime?
  updatedAt      DateTime  @updatedAt
}

model FlowMessage {
  id        String     @id @default(uuid())
  clientId  String
  content   String
  authorId  String
  createdAt DateTime   @default(now())
  author    TeamMember @relation(fields: [authorId], references: [id])
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model GlobalAnnouncement {
  id        String   @id @default(uuid())
  content   String
  type      String
  createdAt DateTime @default(now())
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([authorId, createdAt])
}

model AgencyIntegration {
  id          String   @id @default(uuid())
  type        String // SHEETS, GMAIL, SLIDES
  externalId  String? // Google ID (Spreadsheet ID, etc.)
  alias       String
  isActive    Boolean  @default(true)
  clientId    String?
  credentials Json? // OAuth2 tokens (refresh_token, etc.)
  metadata    Json? // Optional config
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

enum TaskStatus {
  PENDIENTE
  EN_CURSO
  REALIZADA
  DEVUELTA
}

enum ContentPlanStatus {
  PLANIFICACION
  EN_APROBACION
  ACTIVO
  FINALIZADO
}

enum ContentItemStatus {
  BORRADOR
  EN_REVISION
  APROBADO
  PUBLICADO
  REALIZADO
  EN_PRODUCCION
  DEVUELTO
}

enum FeedbackType {
  ESCRITO
  UNO_A_UNO
}

enum EmisorType {
  BRAIN_STUDIO
  FRANCISCO_VILLA
}

enum CurrencyType {
  COP
  USD
}

enum QuotationStatus {
  BORRADOR
  ACTIVA
  APROBADA
}

enum ServiceCategory {
  BRANDING
  DISENO
  PRODUCCION_AUDIOVISUAL
  MARKETING
  ADS
  EDITORIAL
  WEB
  DESARROLLO
}

enum FinancialCategory {
  MEMBRESIA
  PAUTA
  NOMINA
  LOGISTICA
  ADMINISTRATIVO
  TAX
  FINANCIAL
  OPERATIVO
}

enum FinancialType {
  INCOME
  EXPENSE
}

enum FinancialScenario {
  ACTUAL
  FORECAST
  BUDGET
}

enum FinancialRecordStatus {
  DRAFT
  POSTED
  VOIDED
}

enum FinancialRecordOrigin {
  MANUAL
  IMPORT
  SYSTEM
}

enum FinancialAccountType {
  BANK
  CASH
  OTHER
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
}

enum FinancialAuditAction {
  CREATE
  UPDATE
  POST
  VOID
  CLOSE
  REOPEN
  IMPORT
  PAYMENT
}

enum FinancialSection {
  REVENUE
  ADMIN_COST
  OPERATING_EXPENSE
  INVESTMENT
  FINANCING
  RECEIVABLE
  PAYROLL
  OTHER
}

enum FinancialImportStatus {
  PREVIEW
  IMPORTED
  REPLACED
  FAILED
}

model FinancialImportBatch {
  id               String                    @id @default(uuid())
  year             Int
  sourceFilename   String
  sourceHash       String?
  sourceSheets     Json
  status           FinancialImportStatus     @default(PREVIEW)
  summary          Json?
  importedById     String?
  importedBy       User?                     @relation("FinancialImportUser", fields: [importedById], references: [id], onDelete: SetNull)
  importedAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  records          FinancialRecord[]
  monthlySummaries FinancialMonthlySummary[]
  payrollContracts PayrollContract[]
  receivables      AccountsReceivable[]

  @@index([year])
  @@index([status])
  @@index([importedById])
}

model FinancialRecord {
  id                 String                @id @default(uuid())
  amount             Decimal
  category           FinancialCategory
  type               FinancialType
  section            FinancialSection?
  date               DateTime // Accounting date (usually 1st day of month or exact transaction date)
  year               Int?
  month              Int?
  clientId           String?
  client             Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId             String?
  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdById        String?
  createdBy          User?                 @relation("FinancialRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
  accountId          String?
  account            FinancialAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  importBatchId      String?
  importBatch        FinancialImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  description        String?
  sourceSheet        String?
  sourceRow          Int?
  sourceLabel        String?
  scenario           FinancialScenario     @default(ACTUAL)
  status             FinancialRecordStatus @default(POSTED)
  origin             FinancialRecordOrigin @default(MANUAL)
  isProjection       Boolean               @default(false)
  counterparty       String?
  subcategory        String?
  reference          String?
  notes              String?
  attachmentUrl      String?
  attachmentName     String?
  attachmentMimeType String?
  postedAt           DateTime?
  voidedAt           DateTime?
  voidReason         String?
  metadata           Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  receivablePayment  ReceivablePayment?
  payrollTransaction PayrollTransaction?

  @@index([date])
  @@index([year, month])
  @@index([category])
  @@index([type])
  @@index([scenario, status, year, month])
  @@index([accountId, date])
  @@index([createdById, createdAt])
  @@index([userId, year, month])
  @@index([section])
  @@index([clientId, year, month])
  @@index([importBatchId])
}

model FinancialAccount {
  id                 String               @id @default(uuid())
  name               String
  type               FinancialAccountType
  currency           String               @default("COP")
  openingBalance     Decimal              @default(0)
  openingBalanceDate DateTime
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  records            FinancialRecord[]
  payments           ReceivablePayment[]

  @@unique([name, currency])
  @@index([type, isActive])
}

model FinancialPeriod {
  id         String                @id @default(uuid())
  year       Int
  month      Int
  status     FinancialPeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  closedBy   User?                 @relation("FinancialPeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  notes      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([year, month])
  @@index([status, year, month])
  @@index([closedById])
}

model FinancialAuditEvent {
  id         String               @id @default(uuid())
  entityType String
  entityId   String
  action     FinancialAuditAction
  before     Json?
  after      Json?
  actorId    String?
  actor      User?                @relation("FinancialAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime             @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model FinancialMonthlySummary {
  id                         String               @id @default(uuid())
  year                       Int
  month                      Int
  scenario                   FinancialScenario    @default(ACTUAL)
  importBatchId              String
  importBatch                FinancialImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  explicitIncome             Decimal              @default(0)
  calculatedIncome           Decimal              @default(0)
  explicitAdminCost          Decimal              @default(0)
  calculatedAdminCost        Decimal              @default(0)
  explicitOperatingExpense   Decimal              @default(0)
  calculatedOperatingExpense Decimal              @default(0)
  explicitFinancing          Decimal              @default(0)
  calculatedFinancing        Decimal              @default(0)
  explicitDebt               Decimal              @default(0)
  calculatedDebt             Decimal              @default(0)
  netResult                  Decimal              @default(0)
  metadata                   Json?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@unique([year, month, importBatchId])
  @@index([year, month])
}

model PayrollPosition {
  id          String            @id @default(uuid())
  title       String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  contracts   PayrollContract[]
}

model FinancialCollaborator {
  id             String                 @id @default(uuid())
  displayName    String
  normalizedName String                 @unique
  userId         String?
  user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  isActive       Boolean                @default(true)
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  aliases        FinancialImportAlias[]
  contracts      PayrollContract[]

  @@index([userId])
  @@index([isActive])
}

model FinancialImportAlias {
  id              String                @id @default(uuid())
  sourceType      String                @default("PAYROLL")
  sourceLabel     String
  normalizedLabel String
  collaboratorId  String
  collaborator    FinancialCollaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([sourceType, normalizedLabel])
  @@index([collaboratorId])
}

model PayrollContract {
  id             String                 @id @default(uuid())
  userId         String?
  user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  collaboratorId String?
  collaborator   FinancialCollaborator? @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  positionId     String?
  position       PayrollPosition?       @relation(fields: [positionId], references: [id], onDelete: SetNull)
  importBatchId  String?
  importBatch    FinancialImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  baseSalary     Decimal
  socialSecurity Decimal // Fixed absolute value
  startDate      DateTime
  endDate        DateTime?
  sourceSheet    String?
  sourceRow      Int?
  sourceLabel    String?
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  transactions   PayrollTransaction[]

  @@index([userId])
  @@index([collaboratorId])
  @@index([positionId])
  @@index([importBatchId])
  @@index([startDate, endDate])
}

enum PayrollTransactionStatus {
  DRAFT
  APPROVED
  PAID
}

model PayrollTransaction {
  id                String                   @id @default(uuid())
  userId            String?
  user              User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contractId        String
  contract          PayrollContract          @relation(fields: [contractId], references: [id], onDelete: Restrict)
  month             Int // 1 - 12
  year              Int // e.g. 2026
  baseSalary        Decimal                  @default(0)
  socialSecurity    Decimal                  @default(0)
  grossAmount       Decimal                  @default(0)
  deductions        Decimal                  @default(0)
  netAmount         Decimal                  @default(0)
  status            PayrollTransactionStatus @default(DRAFT)
  approvedAt        DateTime?
  paidAt            DateTime?
  financialRecordId String?                  @unique
  financialRecord   FinancialRecord?         @relation(fields: [financialRecordId], references: [id], onDelete: SetNull)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  adjustments       PayrollAdjustment[]

  @@unique([contractId, month, year])
  @@index([contractId])
  @@index([year, month])
}

enum AdjustmentType {
  BONUS
  COMMISSION
  DEDUCTION
  NOVELTY
}

model PayrollAdjustment {
  id            String             @id @default(uuid())
  transactionId String
  transaction   PayrollTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  type          AdjustmentType
  amount        Decimal
  description   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([transactionId])
}

enum ReceivableStatus {
  DEBE
  PAGADO
  PROMESADO
}

model AccountsReceivable {
  id            String                @id @default(uuid())
  clientId      String
  client        Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  importBatchId String?
  importBatch   FinancialImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  amount        Decimal
  period        DateTime // First day of month (e.g. 2026-04-01)
  year          Int?
  month         Int?
  dueDate       DateTime?
  status        ReceivableStatus      @default(DEBE)
  origin        FinancialRecordOrigin @default(MANUAL)
  notes         String?
  comments      String?
  sourceSheet   String?
  sourceRow     Int?
  sourceLabel   String?
  metadata      Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  payments      ReceivablePayment[]

  @@index([clientId])
  @@index([period])
  @@index([year, month])
  @@index([status])
  @@index([status, dueDate])
  @@index([origin, year, month])
  @@index([clientId, year, month])
  @@index([importBatchId])
}

model ReceivablePayment {
  id                String             @id @default(uuid())
  receivableId      String
  receivable        AccountsReceivable @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  accountId         String?
  account           FinancialAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  financialRecordId String?            @unique
  financialRecord   FinancialRecord?   @relation(fields: [financialRecordId], references: [id], onDelete: SetNull)
  amount            Decimal
  paidAt            DateTime
  reference         String?
  notes             String?
  createdById       String?
  createdBy         User?              @relation("ReceivablePaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([receivableId, paidAt])
  @@index([accountId, paidAt])
  @@index([createdById, createdAt])
}

model ServiceCatalog {
  id                  String          @id @default(uuid())
  category            ServiceCategory
  name                String          @unique
  description         String
  costo_real_estimado Decimal?
  valor_neto          Decimal
  valor_neto_actual   Decimal

  @@index([category])
}

model Quotation {
  id                   String          @id @default(uuid())
  consecutive          Int             @default(autoincrement())
  uuid_slug            String          @unique
  emisor_type          EmisorType
  status               QuotationStatus @default(ACTIVA)
  client_name          String
  client_company       String?
  client_email         String
  client_phone         String          @default("")
  is_tax_exempt        Boolean         @default(false)
  items                Json
  currency             CurrencyType    @default(COP)
  exchange_rate        Decimal?
  exchange_rate_source String?
  exchange_rate_date   DateTime?
  subtotal             Decimal
  tax_amount           Decimal
  total_amount         Decimal
  terms_and_conditions String
  created_at           DateTime        @default(now())
  issued_at            DateTime?
  reactivated_at       DateTime?
  accepted_at          DateTime?
  expires_at           DateTime
  updated_at           DateTime        @default(now()) @updatedAt
}

enum MetricPeriodKind {
  MONTHLY
  QUARTERLY
}

enum MetricReportStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum MetricSourcePlatform {
  META_ADS
  ORGANIC_RRSS
}

model MetricReport {
  id                String               @id @default(uuid())
  clientId          String
  client            Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodKind        MetricPeriodKind
  startDate         DateTime
  endDate           DateTime
  status            MetricReportStatus   @default(DRAFT)
  normalizedMetrics Json
  narrative         Json
  sections          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  sources           MetricReportSource[]

  @@index([clientId, startDate, endDate])
  @@index([status, createdAt])
}

model MetricReportSource {
  id             String               @id @default(uuid())
  reportId       String
  report         MetricReport         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sourceId       String               @unique @default(uuid())
  storagePath    String
  platform       MetricSourcePlatform @default(META_ADS)
  screenType     String
  extractionData Json
  confidence     Float
  warnings       Json
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([reportId])
}
