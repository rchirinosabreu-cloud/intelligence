generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cliente de la Agencia
model Client {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // Para urls tipo /sunpartners
  status    String   @default("active") // active, paused, archived
  logoUrl   String?
  createdAt DateTime @default(now())

  // Relaciones
  brandAssets BrandAsset[]
  files       ClientFile[]
  broadcasts  Broadcast[] // Anuncios/Bitácora del cliente
  tasks       ClientTask[] // Pendientes del cliente
}

// Activos de Marca (Colores, Fuentes)
model BrandAsset {
  id        String  @id @default(uuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  type      String  // 'COLOR', 'TYPOGRAPHY', 'LINK'
  name      String  // 'Color Primario', 'Fuente Web'
  value     String  // '#FF0000', 'Montserrat'
}

// Archivos del Cliente (Bucket References)
model ClientFile {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  name        String   // Nombre visible
  bucketUrl   String   // URL del archivo en Railway/S3
  category    String   // 'Legal', 'Deliverable', 'Asset'
  createdAt   DateTime @default(now())
}

// Anuncios / Bitácora (General o Por Cliente)
model Broadcast {
  id        String   @id @default(uuid())
  content   String   // Mensaje del anuncio
  type      String   // 'urgent', 'win', 'info'
  createdAt DateTime @default(now())

  // Relación Opcional con Cliente
  // Si clientId es NULL -> Es un anuncio General (Dashboard)
  // Si clientId tiene valor -> Es un anuncio específico de ese Cliente
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])

  // Metadatos opcionales para UI
  authorName   String? // 'Team Lead', 'Bria', etc.
  authorAvatar String? // URL del avatar
}

// Pendientes del Cliente (To-Do List)
model ClientTask {
  id        String   @id @default(uuid())
  text      String   // Título de la tarea
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
}
